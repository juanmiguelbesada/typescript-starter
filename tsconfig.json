{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "ES2023",
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"module": "Preserve",
		"moduleResolution": "Bundler",
		"noEmit": true
	},
	"include": ["src", "tests"],
	"exclude": ["node_modules"]
}
